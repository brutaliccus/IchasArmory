{
  "name": "ichacalc",
  "version": "1.0.0",
  "description": "Ichabaddie's Armory - WoW Tank Calculator",
  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "icons:unpack": "python scripts/unpack_wow_icon_pack.py",
    "prebuild": "npm run icons:unpack",
    "deploy:pi": "bash scripts/deploy_to_pi.sh",
    "gen:dps-boss-stats": "python scripts/export-dps-raid-boss-stats.py",
    "gen:dps-boss-stats:defaults": "node scripts/generate-dps-raid-boss-stats.mjs",
    "import:loot": "node scripts/import-turtle-atlas-loot.mjs",
    "gen:dps-boss-icons:zam": "python scripts/apply-zam-ej-icons-to-dps-boss-json.py",
    "preview": "vite preview --port 5174",
    "start": "node server.js",
    "compress": "node compress-items.js",
    "watch": "node watch-and-compress.js",
    "dev:watch": "node watch-and-compress.js & node server.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.3",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "express-session": "^1.18.2",
    "html-to-image": "^1.11.13",
    "jsdom": "^27.3.0",
    "lz-string": "^1.5.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-discord-auth": "^1.1.0",
    "session-file-store": "^1.5.0"
  },
  "devDependencies": {
    "vite": "^8.0.7",
    "vite-plugin-static-copy": "^4.0.1"
  }
}
